# --- API auth (required -- see app/main.py require_api_key) ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Send as the X-API-Key header on every request except /health.
API_KEY=

# --- LLM (Gemini free tier, from Google AI Studio) ---
GEMINI_API_KEY=xxxx
REASONING_MODEL=gemini-3.5-flash-lite

# --- Database ---
DATABASE_URL=postgresql://soc2:soc2@localhost:5432/soc2_copilot

# --- GitHub (for PR generation) ---
GITHUB_TOKEN=ghp_xxxx
GITHUB_REPO=your-org/your-demo-repo

# --- Cloud provider for live API adapter (pick one for day one) ---
CLOUD_PROVIDER=aws          # aws | gcp
AWS_PROFILE=readonly-soc2-scan
AWS_REGION=ap-south-1
# GCP_PROJECT_ID=your-project
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/readonly-sa.json

# --- Langfuse (observability) ---
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx
LANGFUSE_HOST=https://cloud.langfuse.com
